digraph G {graph [bgcolor="transparent",pad="0.32",nodesep="0.48",ranksep="0.65",fontname="Arial",splines=ortho]; node [shape=box,style="rounded,filled",fontname="Arial",fontsize=15,color="#A9C7E3",fillcolor="#EDF5FC",fontcolor="#163858",penwidth=1.6,margin="0.23,0.16"]; edge [color="#3376AA",penwidth=2,arrowsize=.8,fontname="Arial",fontsize=11,fontcolor="#3D5870"]; rankdir=LR; p1[label="Proceso / transacción A\nposee recurso R1",fillcolor="#DFF1FF"];r2[label="Recurso R2\nocupado por B",fillcolor="#FFF1D8"];p2[label="Proceso / transacción B\nposee recurso R2",fillcolor="#F0E8FF"];r1[label="Recurso R1\nocupado por A",fillcolor="#FFF1D8"];p1->r2[label="espera"];r2->p2[label="asignado"];p2->r1[label="espera"];r1->p1[label="asignado"];}