digraph G {graph [bgcolor="transparent",pad="0.32",nodesep="0.48",ranksep="0.65",fontname="Arial",splines=ortho]; node [shape=box,style="rounded,filled",fontname="Arial",fontsize=15,color="#A9C7E3",fillcolor="#EDF5FC",fontcolor="#163858",penwidth=1.6,margin="0.23,0.16"]; edge [color="#3376AA",penwidth=2,arrowsize=.8,fontname="Arial",fontsize=11,fontcolor="#3D5870"]; rankdir=LR; nuevo[label="Nuevo"];listo[label="Listo",fillcolor="#D8ECFF"];ejec[label="Ejecución",fillcolor="#DCF4DF"];bloq[label="Bloqueado\nespera E/S",fillcolor="#FFF0D5"];fin[label="Terminado",fillcolor="#F2E5F8"];nuevo->listo[label="admitir"];listo->ejec[label="despacho"];ejec->bloq[label="espera"];bloq->listo[label="recurso listo"];ejec->fin[label="finaliza"];ejec->listo[label="interrupción",constraint=false];}